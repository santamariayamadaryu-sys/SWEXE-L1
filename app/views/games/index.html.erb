<h1>ゲーム一覧</h1>

<%= link_to "ゲームを追加", new_game_path %>

<table>
  <thead>
    <tr>
      <th>タイトル</th>
      <th>ジャンル</th>
      <th>評価</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @games.each do |game| %>
      <tr>
        <td><%= game.title %></td>
        <td><%= game.genre %></td>
        <td><%= game.rating %></td>
        <td>
          <%= link_to "詳細", game_path(game) %>
          <%= link_to "編集", edit_game_path(game) %>
          <%= button_to "削除", game_path(game), method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
